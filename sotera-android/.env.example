DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/sotera
SESSION_SECRET=replace-with-a-long-random-secret
PORT=3000
# Optional HTTPS: set paths to a valid certificate and private key.
# TLS_CERT_PATH=C:\path\to\certificate.pem
# TLS_KEY_PATH=C:\path\to\private-key.pem
BACKUP_DIR=./backups
BACKUP_PASSPHRASE=replace-with-a-long-random-backup-encryption-passphrase
BACKUP_RETENTION_DAYS=35
